<!DOCTYPE html>
<html>
<head>
    <title>Flappy Bird Game</title>
    <style>
        body {
            margin: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            background: #70c5ce;
            height: 100vh;
            font-family: Arial;
        }

        #gameCanvas {
            background: #4EC0CA;
            border: 3px solid black;
        }

        h1 {
            color: white;
            position: absolute;
            top: 10px;
        }
    </style>
</head>

<body>
    <h1>Flappy Bird by YOU</h1>
    <canvas id="gameCanvas" width="400" height="600"></canvas>

    <script>
        const canvas = document.getElementById("gameCanvas");
        const ctx = canvas.getContext("2d");

        let bird = { x: 50, y: 50, width: 30, height: 30, gravity: 1, lift: -15, velocity: 0 };
        let pipes = [];
        let score = 0;
        let gameOver = false;

        function createPipe() {
            let gap = 150;
            let topHeight = Math.random() * 300 + 50;
            let bottomHeight = canvas.height - topHeight - gap;

            pipes.push({
                x: canvas.width,
                top: topHeight,
                bottom: bottomHeight,
                width: 60
            });
        }

        document.addEventListener("keydown", () => {
            bird.velocity = bird.lift;
        });

        function update() {
            if (gameOver) return;

            bird.velocity += bird.gravity;
            bird.y += bird.velocity;

            if (bird.y + bird.height > canvas.height || bird.y < 0) {
                endGame();
            }

            pipes.forEach((pipe, i) => {
                pipe.x -= 3;

                // collision
                if (
                    bird.x < pipe.x + pipe.width &&
                    bird.x + bird.width > pipe.x &&
                    (bird.y < pipe.top || bird.y + bird.height > canvas.height - pipe.bottom)
                ) {
                    endGame();
                }

                // score
                if (pipe.x + pipe.width === bird.x) {
                    score++;
                }

                // remove off-screen pipe
                if (pipe.x + pipe.width < 0) {
                    pipes.splice(i, 1);
                }
            });

            if (pipes.length === 0 || pipes[pipes.length - 1].x < 200) {
                createPipe();
            }
        }

        function draw() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            // bird
            ctx.fillStyle = "yellow";
            ctx.fillRect(bird.x, bird.y, bird.width, bird.height);

            // pipes
            ctx.fillStyle = "green";
            pipes.forEach(pipe => {
                ctx.fillRect(pipe.x, 0, pipe.width, pipe.top);
                ctx.fillRect(pipe.x, canvas.height - pipe.bottom, pipe.width, pipe.bottom);
            });

            // score
            ctx.fillStyle = "white";
            ctx.font = "30px Arial";
            ctx.fillText("Score: " + score, 10, 40);

            if (gameOver) {
                ctx.fillStyle = "red";
                ctx.font = "40px Arial";
                ctx.fillText("GAME OVER", 80, 300);
                ctx.font = "20px Arial";
                ctx.fillText("Refresh to play again", 120, 340);
            }
        }

        function endGame() {
            gameOver = true;
        }

        function gameLoop() {
            update();
            draw();
            requestAnimationFrame(gameLoop);
        }

        gameLoop();
        createPipe();
    </script>

</body>
</html>
